# Gateway MCP Server Configuration Template
# Copy this file to .env and customize with your settings.
#
# IMPORTANT: ignition_mcp.config.Settings loads its own .env relative to the
# CURRENT WORKING DIRECTORY of whatever process imports it -- not relative to
# the ignition-mcp source tree. Since the gateway imports ignition_mcp.server
# and is normally run from this directory, THIS .env is what ignition-mcp's
# settings will actually read. docker-mcp has no .env of its own; it talks to
# the Docker socket/DOCKER_HOST directly (see docker-compose.yml).

# =============================================================================
# GATEWAY SETTINGS
# =============================================================================

# Required. Clients must send this as the X-API-Key header to reach /docker or
# /ignition (/health and /docs stay open). No default -- the gateway refuses
# to start without one, since /docker exposes container creation and
# /ignition exposes writes to live industrial systems.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# =============================================================================
# IGNITION-MCP SETTINGS (passed through -- see ignition/ignition-mcp/.env.example
# for the full annotated reference)
# =============================================================================

IGNITION_MCP_IGNITION_GATEWAY_URL=http://localhost:8088
IGNITION_MCP_IGNITION_API_KEY=
IGNITION_MCP_IGNITION_USERNAME=admin
IGNITION_MCP_IGNITION_PASSWORD=password



IGNITION_MCP_WEBDEV_TAG_ENDPOINT=
IGNITION_MCP_WEBDEV_TAG_CONFIG_ENDPOINT=
IGNITION_MCP_WEBDEV_ALARM_ENDPOINT=
IGNITION_MCP_WEBDEV_TAG_HISTORY_ENDPOINT=
IGNITION_MCP_WEBDEV_SCRIPT_EXEC_ENDPOINT=
IGNITION_MCP_ENABLE_SCRIPT_EXECUTION=false

# server_host / server_port are read by ignition-mcp but unused here -- the
# gateway serves /ignition itself via GATEWAY_HOST / GATEWAY_PORT above.
