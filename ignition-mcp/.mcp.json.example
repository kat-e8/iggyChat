{
  "mcpServers": {
    "ignition-mcp": {
      "command": "uv",
      "args": ["run", "--no-sync", "python", "mcp_server.py", "--transport", "stdio"],
      "env": {
        "IGNITION_MCP_IGNITION_GATEWAY_URL": "https://your-gateway:8043",
        "IGNITION_MCP_IGNITION_API_KEY": "your-api-key-here",
        "IGNITION_MCP_SSL_VERIFY": "false"
      }
    }
  }
}
