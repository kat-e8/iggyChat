# Chat Bridge configuration template. Copy to .env and customize.

# =============================================================================
# IGNITION MCP -- shared gateway, not owned by this project (see Phase10)
# =============================================================================

# This project does not run its own gateway -- it talks to the mcp-gateway
# container the infra repo deploys alongside it on the "edge" network. The
# default below is that container; set this only when running outside that
# network (e.g. local dev against a gateway published somewhere else).
IGNITION_MCP_URL=http://mcp-gateway:8000/ignition/mcp

# The shared gateway's own API key, sent as X-API-Key. Not generated by this
# project -- get it from wherever the shared gateway's credentials are kept.
IGNITION_MCP_API_KEY=

# Which Ignition gateway or Canary Historian a chat reaches is not set here:
# users create named aliases (URL + API key) at runtime with the Aliases
# button in the app, shared by every user, and name them in their messages
# ("on ign-stage, what tags exist?"). They are stored in this SQLite file --
# in docker-compose.yml it is /data/aliases.db on the persistent volume, next
# to users.db. It holds API keys: keep the volume as private as users.db.
CHAT_BRIDGE_ALIASES_DB_PATH=chat_bridge_aliases.db

# =============================================================================
# CANARY GATEWAY (canary-mcp-gateway) -- Canary Labs Historian MCP, its own
# scope, never combined with Ignition. This endpoint has no API-key auth at
# all -- access control is network reachability only. The default is the
# canary-mcp-gateway container on the "edge" network, so unset is fine unless
# running outside that network.
#
# Historians are reached through aliases created in the app (see
# CHAT_BRIDGE_ALIASES_DB_PATH above); the gateway's own connections.yaml
# entries still work by name too. A Canary alias stores only the Historian's
# base URL; the read/write API ports below are added to it per call.
# =============================================================================
CANARY_READ_PORT=55236
CANARY_WRITE_PORT=55293
CANARY_GATEWAY_URL=http://canary-mcp-gateway:8000/canary/mcp

# =============================================================================
# THIS SERVICE'S OWN BIND ADDRESS
# =============================================================================

# frontend/proxy.conf.json's /api target should point here (repointed from
# its current :9000, which targets the frontend's unused Express skeleton).
CHAT_BRIDGE_HOST=127.0.0.1
CHAT_BRIDGE_PORT=8001

# =============================================================================
# AUTH -- permanent users (user_store.py), JWT. Signup is closed.
# =============================================================================

# Required. Signs/verifies the access_token cookie issued by /api/auth/login.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Access token lifetime, in minutes. Also used as the cookie's Max-Age.
JWT_EXPIRE_MINUTES=1440

# Set true once the Chat Bridge is served over https -- keeps the
# access_token cookie off the wire on plain http.
COOKIE_SECURE=false

# There is no /api/auth/signup -- accounts are provisioned by the operator,
# on top of this app's tailnet-only network access:
#   docker exec -it rosetta-chat-bridge /app/.venv/bin/python -m chat_bridge.manage_users add you@example.com
# A mock account (test@angular-university.io / Angular123) is seeded on
# startup if it doesn't already exist, so a fresh install still has
# something to log in with.

# Where accounts (user_store.py) are persisted. In docker-compose.yml this is
# set to /data/users.db on the same named volume as usage.db, so accounts
# survive redeploys; left as a local relative path here for running outside
# compose.
CHAT_BRIDGE_USERS_DB_PATH=chat_bridge_users.db

# =============================================================================
# CLAUDE AGENT SDK
# =============================================================================

# Optional model override (e.g. "sonnet", "opus"). Leave blank to use the SDK
# default.
CLAUDE_MODEL=

# claude-agent-sdk reads this from the process environment -- which is this
# file for a container (env_file:), or your own shell for local dev.
# Previously documented as "set it in whatever shell/service manager
# launches the Chat Bridge" and passed through docker-compose.yml's
# `environment:` block -- that only ever worked for a manual `docker
# compose up` in a shell where you'd exported it first. deploy.yml's
# automated runs never did, so every CI-driven deploy silently ran with
# this blank. Fixed by moving it here, alongside the other secrets
# (GATEWAY_API_KEY, JWT_SECRET) that deploy.yml already stages from
# ~/.config/iggychat/chat-bridge.env on every deploy.
ANTHROPIC_API_KEY=

# Where cumulative usage (usage_store.py) is persisted. In docker-compose.yml
# this is set to /data/usage.db on a named volume so it survives redeploys;
# left as a local relative path here for running outside compose.
CHAT_BRIDGE_USAGE_DB_PATH=chat_bridge_usage.db

# Optional hard caps, both real money and both disabled (blank) by default --
# set these to whatever your own budget actually is, not a guessed default.
# Daily: cumulative spend across every session, checked before every message.
# Session: passed straight to ClaudeAgentOptions.max_budget_usd, enforced by
# the SDK itself for one WebSocket connection's conversation.
CHAT_BRIDGE_MAX_DAILY_BUDGET_USD=
CHAT_BRIDGE_MAX_SESSION_BUDGET_USD=

# =============================================================================
# DEPLOY -- serving the built Angular app from this process (optional)
# =============================================================================

# Leave blank for local dev -- `ng serve`'s own proxy serves the frontend and
# forwards only /api here. Set to an absolute path to a built Angular output
# (see Dockerfile) to have this process serve it directly, with SPA-route
# fallback to its index.html, so it's the single public entry point.
FRONTEND_DIST_PATH=
