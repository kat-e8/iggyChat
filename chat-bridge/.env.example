# Chat Bridge configuration template. Copy to .env and customize.

# =============================================================================
# MCP GATEWAY (backend/mcp-gateway) -- internal only, never exposed to the browser
# =============================================================================

GATEWAY_URL=http://127.0.0.1:8000

# Must match GATEWAY_API_KEY in backend/mcp-gateway/.env. Sent as X-API-Key to
# reach the Gateway's /docker and /ignition sub-apps.
GATEWAY_API_KEY=

# Running via this repo's own docker-compose.yml (Chat Bridge alone, no
# `gateway` service to resolve by name)? 127.0.0.1 above means the
# container itself, not your host machine or the Gateway's real location --
# point GATEWAY_URL at http://host.docker.internal:8000 (Gateway on the same
# host, Docker Desktop) or wherever it's actually reachable from inside the
# container instead. Not an issue with backend/mcp-gateway/docker-compose.yml,
# which sets GATEWAY_URL=http://gateway:8000 for you via compose DNS.

# =============================================================================
# THIS SERVICE'S OWN BIND ADDRESS
# =============================================================================

# frontend/proxy.conf.json's /api target should point here (repointed from
# its current :9000, which targets the frontend's unused Express skeleton).
CHAT_BRIDGE_HOST=127.0.0.1
CHAT_BRIDGE_PORT=8001

# =============================================================================
# AUTH -- mock user (test@angular-university.io / Angular123), JWT, no DB
# =============================================================================

# Required. Signs/verifies the access_token cookie issued by /api/auth/login
# and /api/auth/signup. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Access token lifetime, in minutes. Also used as the cookie's Max-Age.
JWT_EXPIRE_MINUTES=1440

# Set true once the Chat Bridge is served over https -- keeps the
# access_token cookie off the wire on plain http.
COOKIE_SECURE=false

# =============================================================================
# CLAUDE AGENT SDK
# =============================================================================

# Optional model override (e.g. "sonnet", "opus"). Leave blank to use the SDK
# default.
CLAUDE_MODEL=

# claude-agent-sdk itself reads ANTHROPIC_API_KEY (or a logged-in Claude Code
# CLI) directly from the process environment -- not from this file. Set it in
# whatever shell/service manager launches the Chat Bridge.

# =============================================================================
# DEPLOY -- serving the built Angular app from this process (optional)
# =============================================================================

# Leave blank for local dev -- `ng serve`'s own proxy serves the frontend and
# forwards only /api here. Set to an absolute path to a built Angular output
# (see Dockerfile) to have this process serve it directly, with SPA-route
# fallback to its index.html, so it's the single public entry point.
FRONTEND_DIST_PATH=
