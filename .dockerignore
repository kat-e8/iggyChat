# Build context root is the repo root (see gateway/Dockerfile). uv sync
# rebuilds .venv fresh inside the container -- the host's Windows .venv would
# just bloat the build and doesn't run on Linux anyway.
**/.venv
**/__pycache__
**/*.py[oc]
**/.pytest_cache
.git
**/.env
*.log

# Not needed inside the gateway image; keeps the build context small.
frontend/node_modules
frontend/dist
frontend/.angular
*.pdf
*.pptx
*.zip
*.mp4
*.mov
